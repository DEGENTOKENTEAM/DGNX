{
  "name": "hardhat-project",
  "scripts": {
    "test": "USE_REAL_ACCOUNTS=false npx hardhat test",
    "test:latest-controller": "USE_REAL_ACCOUNTS=false npx hardhat test ./test/controllerv3.spec.ts",
    "deploy": "USE_REAL_ACCOUNTS=true LOCALFORK_RPC_NETWORK=mainnet-avax USE_LOCALFORK_INSTEAD=true npx hardhat --network mainnet-avax deploy",
    "deploy:mainnet": "USE_REAL_ACCOUNTS=true LOCALFORK_RPC_NETWORK=mainnet-avax USE_LOCALFORK_INSTEAD=false npx hardhat --network mainnet-avax deploy",
    "coverage": "USE_REAL_ACCOUNTS=false npx hardhat coverage",
    "show-coverage": "npx http-server ./coverage/"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.4.7",
